# Groq API Key (get a free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Mock Mode: set to true to demo completely offline with deterministic responses
MOCK_LLM=true

# Groq Rate Limiting (Free tier default: 25 requests/minute)
RATE_LIMIT_RPM=25

# Cache directory for LLM responses
CACHE_DIR=data/cache

# SQLite Database path
DATABASE_PATH=data/redloop.db

# Server settings
HOST=0.0.0.0
PORT=8000

